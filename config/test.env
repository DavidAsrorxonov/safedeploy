# shellcheck shell=bash

# Non-secret configuration used only by automated tests.

REMOTE_HOST="deploy@example.test"
REMOTE_PATH="/tmp/safedeploy-test"
REPOSITORY_URL="git@example.test:team/test-app.git"

INSTALL_CMD=""
BUILD_CMD=""

SERVICE_NAME="test-app"
RESTART_CMD="true"
STOP_CMD="true"
CHECK_STOPPED_CMD="true"

HEALTHCHECK_URL="http://127.0.0.1:3000/health"
HEALTHCHECK_EXPECT_STATUS=200
HEALTHCHECK_EXPECT_BODY='"status":"ok"'
HEALTHCHECK_REQUIRE_RELEASE_ID=false
HEALTHCHECK_MAX_ATTEMPTS=7

SLACK_WEBHOOK_URL=""