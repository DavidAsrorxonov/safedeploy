# shellcheck shell=bash

# Copy this file to config/<environment>.env.
# Environment files are trusted Bash assignment files.
# WARNING: Never commit files containing real credentials.

REMOTE_HOST="deploy@example.com"
REMOTE_PATH="/var/www/myapp"
REPOSITORY_URL="git@example.com:team/myapp.git"

INSTALL_CMD="npm ci"
BUILD_CMD="npm run build"

SERVICE_NAME="myapp"
RESTART_CMD="sudo -n systemctl restart myapp"
STOP_CMD="sudo -n systemctl stop myapp"
CHECK_STOPPED_CMD='test "$(systemctl show myapp --property=ActiveState --value)" = inactive'

HEALTHCHECK_URL="http://127.0.0.1:3000/health"
HEALTHCHECK_EXPECT_STATUS=200
HEALTHCHECK_EXPECT_BODY='"status":"ok"'
HEALTHCHECK_REQUIRE_RELEASE_ID=false

SLACK_WEBHOOK_URL=""

# Optional environment-specific overrides:
# AUTO_ROLLBACK=true
# RELEASES_TO_KEEP=5
# HEALTHCHECK_MAX_ATTEMPTS=10
# HEALTHCHECK_DEADLINE_SECONDS=60